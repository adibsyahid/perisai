# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web config (public by design: it is sent to every browser; Security Rules protect the data).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SECRET, server only: Firebase Admin service account (from the JSON key file).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SECRET, server only: Gemini API key from Google AI Studio.
GEMINI_API_KEY=
